# ─────────────────────────────────────────────────────────────────────────────
# Rent ERP — Environment variable template
#
# Copy this file to .env and fill in your real values.
# .env is gitignored. This file (.env.example) IS committed — it documents
# what every developer / deployment needs to supply.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=local                        # local | staging | production
SERVER_PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=renterp
DB_USERNAME=postgres
DB_PASSWORD=

# ── Dev security (Spring HTTP basic — removed once auth is live) ──────────────
DEV_SECURITY_USER=dev
DEV_SECURITY_PASSWORD=

# ── JWT / Session ─────────────────────────────────────────────────────────────
JWT_SECRET=                          # Min 32 chars, random

# Requests without a token are rejected unless this is false. Leave unset (true)
# everywhere except a developer machine running the pre-auth Postman collections.
# AUTH_ENFORCED=false

# ── Sparrow SMS (OTP delivery) ────────────────────────────────────────────────
SPARROW_SMS_TOKEN=

# ── AWS S3 (meter photos, KYC images) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1

# ── Payment Gateways ──────────────────────────────────────────────────────────
KHALTI_SECRET_KEY=
ESEWA_SECRET_KEY=

# ── Firebase Cloud Messaging ──────────────────────────────────────────────────
FCM_SERVER_KEY=
