# ─────────────────────────────────────────────────────────────────────────────
# Rent ERP — Environment variable template
#
# Copy this file to .env and fill in your real values.
# .env is gitignored. This file (.env.example) IS committed — it documents
# what every developer / deployment needs to supply.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=local                        # local | staging | production
SERVER_PORT=8080
OTP_DEV_FIXED_CODE=

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=renterp
DB_USERNAME=postgres
DB_PASSWORD=

# ── JWT / Session ─────────────────────────────────────────────────────────────
JWT_SECRET=                          # Min 32 chars, random

# Requests without a token are rejected unless this is false. Leave unset (true)
# everywhere except a developer machine running the pre-auth Postman collections.
# AUTH_ENFORCED=false

# Folder for uploaded files (development storage). Default ./uploads, next to
# where the backend runs. Not used once S3 / Supabase Storage is configured.
# FILES_DIR=./uploads

# Upload quotas per user (M21). Defaults: 100 uploads a day, 500 MB kept.
# FILES_MAX_UPLOADS_PER_DAY=100
# FILES_MAX_TOTAL_MB_PER_USER=500

# ── Logging (C10) ─────────────────────────────────────────────────────────────
# Production-safe defaults: INFO for the app, no SQL, no bind values.
# On a developer machine you may raise them, e.g.:
# APP_LOG_LEVEL=DEBUG
# SQL_LOG_LEVEL=DEBUG
# SQL_BIND_LOG_LEVEL=TRACE      (prints values incl. password/token hashes - local only!)
# WEB_LOG_LEVEL=DEBUG
# LOG_DIR=logs

# ── Request limits (H11) ──────────────────────────────────────────────────────
# Leave unset (true) everywhere except a developer machine running the live
# PowerShell test scripts, which send many requests from one address.
# RATE_LIMIT_ENABLED=false

# ── Reverse proxy / CORS (H11, H17) ───────────────────────────────────────────
# native = trust X-Forwarded-For from proxies on a private network (default).
# FORWARD_HEADERS_STRATEGY=native
# Browser origins allowed to call the API, comma-separated. Empty = none.
# APP_CORS_ALLOWED_ORIGINS=https://admin.example.com

# ── Tenancy / sessions ────────────────────────────────────────────────────────
# How long a join request waits for the owner, in hours (H12). Default 168 (7 days).
# JOIN_REQUEST_TTL_HOURS=168
# Signed-in devices per account before the oldest is signed out (M16). Default 10.
# MAX_SESSIONS_PER_USER=10

# ── Sparrow SMS (OTP delivery) ────────────────────────────────────────────────
SPARROW_SMS_TOKEN=
# DEV ONLY (APP_ENV=local): make every OTP this 6-digit code until SMS is wired.
# Leave empty everywhere else - the app refuses to start otherwise.
# OTP_DEV_FIXED_CODE=123456

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Sends password-reset / email-change codes to email addresses, and new support
# tickets to SUPPORT_INBOX. Leave MAIL_HOST empty to send no email (codes then
# go to the backend log in local, and a 503 elsewhere).
# Gmail example: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=the
# address, MAIL_PASSWORD=an App Password (Google account → Security → App
# passwords), MAIL_FROM=Rentlo <the address>.
MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=Rentlo <no-reply@rentlo.app>
# MAIL_STARTTLS=true      (port 587)
# MAIL_SSL=false          (true for port 465)
# Contact Support tickets are emailed here (needs MAIL_HOST). Empty = stored only.
# SUPPORT_INBOX=rentlocontact@gmail.com

# ── AWS S3 (meter photos, KYC images) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1

# ── Payment Gateways ──────────────────────────────────────────────────────────
KHALTI_SECRET_KEY=
ESEWA_SECRET_KEY=

# ── Firebase Cloud Messaging ──────────────────────────────────────────────────
FCM_SERVER_KEY=
