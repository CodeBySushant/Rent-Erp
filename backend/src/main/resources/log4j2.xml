<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">

    <Properties>
        <!-- Full pattern for file logs: timestamp, level, thread, logger, message -->
        <Property name="FILE_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %logger{40} - %msg%n%throwable</Property>
        <!-- Named LOG_PATH, not LOG_DIR: a property that refers to its own name loops in Log4j2. -->
        <Property name="LOG_PATH">${sys:LOG_DIR:-${env:LOG_DIR:-logs}}</Property>
        <Property name="APP">rent-erp</Property>

        <!--
            Log levels (C10). Production-safe by default; raise them per machine
            with environment variables (or backend/.env):

              APP_LOG_LEVEL       com.renterp            default INFO   (DEBUG locally)
              SQL_LOG_LEVEL       org.hibernate.SQL      default WARN   (DEBUG prints queries)
              SQL_BIND_LOG_LEVEL  bind parameters        default OFF    (TRACE prints VALUES -
                                  password hashes, token hashes, phone and ID numbers.
                                  Never enable outside a developer machine.)
              WEB_LOG_LEVEL       Spring web + security  default INFO
        -->
        <Property name="APP_LEVEL">${sys:APP_LOG_LEVEL:-${env:APP_LOG_LEVEL:-INFO}}</Property>
        <Property name="SQL_LEVEL">${sys:SQL_LOG_LEVEL:-${env:SQL_LOG_LEVEL:-WARN}}</Property>
        <Property name="SQL_BIND_LEVEL">${sys:SQL_BIND_LOG_LEVEL:-${env:SQL_BIND_LOG_LEVEL:-OFF}}</Property>
        <Property name="WEB_LEVEL">${sys:WEB_LOG_LEVEL:-${env:WEB_LOG_LEVEL:-INFO}}</Property>
    </Properties>

    <Appenders>

        <!-- ── Console (colored) ──────────────────────────────────────────────── -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout>
                <!--
                    %d    — timestamp
                    %highlight — colored level
                    [%t]  — thread name (virtual threads show as "virtual-X")
                    %style{%logger{36}}{cyan} — logger name in cyan
                    %msg  — message
                    %n    — newline
                    %throwable — full stack trace on error
                -->
                <Pattern>%d{HH:mm:ss.SSS} %highlight{%-5level}{FATAL=red blink, ERROR=red bold, WARN=yellow bold, INFO=green, DEBUG=cyan, TRACE=white} [%t] %style{%logger{36}}{bright,cyan} - %msg%n%throwable</Pattern>
            </PatternLayout>
        </Console>

        <!-- ── Main rolling file ──────────────────────────────────────────────── -->
        <RollingFile name="FileAppender"
                     fileName="${LOG_PATH}/${APP}.log"
                     filePattern="${LOG_PATH}/${APP}-%d{yyyy-MM-dd}-%i.log.gz"
                     immediateFlush="true">
            <PatternLayout pattern="${FILE_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <!-- ── SQL-only rolling file (keep shorter — can be huge) ─────────────── -->
        <RollingFile name="SqlAppender"
                     fileName="${LOG_PATH}/${APP}-sql.log"
                     filePattern="${LOG_PATH}/${APP}-sql-%d{yyyy-MM-dd}-%i.log.gz"
                     immediateFlush="true">
            <PatternLayout pattern="${FILE_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="20MB"/>
            </Policies>
            <DefaultRolloverStrategy max="7"/>
        </RollingFile>

    </Appenders>

    <Loggers>

        <!-- ── Application code: DEBUG ────────────────────────────────────────── -->
        <Logger name="com.renterp" level="${APP_LEVEL}" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- ── SQL queries (DEBUG shows the query) ────────────────────────────── -->
        <Logger name="org.hibernate.SQL" level="${SQL_LEVEL}" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="SqlAppender"/>
        </Logger>

        <!-- ── SQL bind parameters (TRACE shows actual values) ────────────────── -->
        <Logger name="org.hibernate.orm.jdbc.bind" level="${SQL_BIND_LEVEL}" additivity="false">
            <AppenderRef ref="SqlAppender"/>
        </Logger>

        <!-- ── Hibernate statistics / slow queries ────────────────────────────── -->
        <Logger name="org.hibernate.stat" level="${SQL_LEVEL}" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- ── Flyway migration progress ──────────────────────────────────────── -->
        <Logger name="org.flywaydb" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- ── db-scheduler job execution ─────────────────────────────────────── -->
        <Logger name="com.github.kagkarlsson" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- ── HikariCP connection pool ───────────────────────────────────────── -->
        <Logger name="com.zaxxer.hikari" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- ── Spring Web (request mapping, filter chain) ─────────────────────── -->
        <Logger name="org.springframework.web" level="${WEB_LEVEL}" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- ── Spring Security filter decisions ───────────────────────────────── -->
        <Logger name="org.springframework.security" level="${WEB_LEVEL}" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- ── Spring Framework internals (INFO to avoid noise) ───────────────── -->
        <Logger name="org.springframework" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- ── Root: WARN catches everything not explicitly configured ─────────── -->
        <Root level="WARN">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Root>

    </Loggers>

</Configuration>
