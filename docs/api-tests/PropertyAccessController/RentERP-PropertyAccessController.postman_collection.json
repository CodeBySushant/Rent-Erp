{
    "info": {
        "name": "Rent ERP \u2014 PropertyAccessController",
        "description": "CRUD + revoke endpoints for the property_access table. Create 4 users via UserController first (owner, manager, viewer, other) and set ownerUserId/managerUserId/viewerUserId/otherUserId collection variables, then run top to bottom.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080",
            "type": "string"
        },
        {
            "key": "ownerUserId",
            "value": "",
            "type": "string"
        },
        {
            "key": "managerUserId",
            "value": "",
            "type": "string"
        },
        {
            "key": "viewerUserId",
            "value": "",
            "type": "string"
        },
        {
            "key": "otherUserId",
            "value": "",
            "type": "string"
        },
        {
            "key": "propertyId",
            "value": "",
            "type": "string"
        },
        {
            "key": "ownerGrantId",
            "value": "",
            "type": "string"
        },
        {
            "key": "managerGrantId",
            "value": "",
            "type": "string"
        },
        {
            "key": "viewerGrantId",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "PropertyAccess",
            "item": [
                {
                    "name": "01 \u2014 Create property (auto-creates OWNER grant)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/properties",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "properties"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"ownerUserId\": \"{{ownerUserId}}\",\n  \"name\": \"Access Test Property\"\n}"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status is 201', () => pm.response.to.have.status(201));",
                                    "const body = pm.response.json();",
                                    "if (body.data && body.data.id) { pm.collectionVariables.set('propertyId', body.data.id); }"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "02 \u2014 List access by propertyId (verify auto OWNER grant)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/property-access?propertyId={{propertyId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "property-access?propertyId={{propertyId}}"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status is 200', () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.test('one OWNER grant exists', () => pm.expect(body.data.content.length).to.eql(1));",
                                    "pm.test('role is OWNER', () => pm.expect(body.data.content[0].role).to.eql('OWNER'));",
                                    "pm.collectionVariables.set('ownerGrantId', body.data.content[0].id);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "03 \u2014 Grant MANAGER access",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/property-access",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "property-access"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"propertyId\": \"{{propertyId}}\",\n  \"userId\": \"{{managerUserId}}\",\n  \"role\": \"MANAGER\",\n  \"grantedBy\": \"{{ownerUserId}}\"\n}"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status is 201', () => pm.response.to.have.status(201));",
                                    "const body = pm.response.json();",
                                    "pm.collectionVariables.set('managerGrantId', body.data.id);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "04 \u2014 Grant VIEW_ONLY access",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/property-access",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "property-access"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"propertyId\": \"{{propertyId}}\",\n  \"userId\": \"{{viewerUserId}}\",\n  \"role\": \"VIEW_ONLY\",\n  \"grantedBy\": \"{{ownerUserId}}\"\n}"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status is 201', () => pm.response.to.have.status(201));",
                                    "const body = pm.response.json();",
                                    "pm.collectionVariables.set('viewerGrantId', body.data.id);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "05 \u2014 Duplicate grant for same property+user \u2192 409",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/property-access",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "property-access"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"propertyId\": \"{{propertyId}}\",\n  \"userId\": \"{{managerUserId}}\",\n  \"role\": \"VIEW_ONLY\"\n}"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status is 409', () => pm.response.to.have.status(409));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "06 \u2014 Grant role=OWNER directly \u2192 400",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/property-access",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "property-access"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"propertyId\": \"{{propertyId}}\",\n  \"userId\": \"{{otherUserId}}\",\n  \"role\": \"OWNER\"\n}"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status is 400', () => pm.response.to.have.status(400));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "07 \u2014 List access by userId (managerUserId)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/property-access?userId={{managerUserId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "property-access?userId={{managerUserId}}"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status is 200', () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.test('one grant found', () => pm.expect(body.data.content.length).to.eql(1));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "08 \u2014 Get single grant by id",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/property-access/{{managerGrantId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "property-access",
                                "{{managerGrantId}}"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status is 200', () => pm.response.to.have.status(200));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "09 \u2014 Update MANAGER -> VIEW_ONLY",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/property-access/{{managerGrantId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "property-access",
                                "{{managerGrantId}}"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"role\": \"VIEW_ONLY\"\n}"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status is 200', () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.test('role is now VIEW_ONLY', () => pm.expect(body.data.role).to.eql('VIEW_ONLY'));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "10 \u2014 Update role to OWNER \u2192 400",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/property-access/{{viewerGrantId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "property-access",
                                "{{viewerGrantId}}"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"role\": \"OWNER\"\n}"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status is 400', () => pm.response.to.have.status(400));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "11 \u2014 Update the OWNER grant itself \u2192 400",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/property-access/{{ownerGrantId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "property-access",
                                "{{ownerGrantId}}"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"role\": \"MANAGER\"\n}"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status is 400', () => pm.response.to.have.status(400));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "12 \u2014 Revoke (DELETE) the OWNER grant \u2192 400",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/property-access/{{ownerGrantId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "property-access",
                                "{{ownerGrantId}}"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status is 400', () => pm.response.to.have.status(400));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "13 \u2014 Revoke the VIEW_ONLY grant \u2192 200",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/property-access/{{viewerGrantId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "property-access",
                                "{{viewerGrantId}}"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status is 200', () => pm.response.to.have.status(200));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "14 \u2014 Get revoked grant, confirm active=false",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/property-access/{{viewerGrantId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "property-access",
                                "{{viewerGrantId}}"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status is 200', () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.test('active is false', () => pm.expect(body.data.active).to.eql(false));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "15 \u2014 Get non-existent grant \u2192 404",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/property-access/00000000-0000-0000-0000-000000000000",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "property-access",
                                "00000000-0000-0000-0000-000000000000"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status is 404', () => pm.response.to.have.status(404));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "16 \u2014 Create grant, non-existent propertyId \u2192 404",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/property-access",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "property-access"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"propertyId\": \"00000000-0000-0000-0000-000000000000\",\n  \"userId\": \"{{otherUserId}}\",\n  \"role\": \"MANAGER\"\n}"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status is 404', () => pm.response.to.have.status(404));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "17 \u2014 Create grant, non-existent userId \u2192 404",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/property-access",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "property-access"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"propertyId\": \"{{propertyId}}\",\n  \"userId\": \"00000000-0000-0000-0000-000000000000\",\n  \"role\": \"MANAGER\"\n}"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status is 404', () => pm.response.to.have.status(404));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "18 \u2014 Create grant, missing role \u2192 400",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/property-access",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "property-access"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"propertyId\": \"{{propertyId}}\",\n  \"userId\": \"{{otherUserId}}\"\n}"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('status is 400', () => pm.response.to.have.status(400));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}