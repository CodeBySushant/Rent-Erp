                                "v1",
                                "properties"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"ownerUserId\": \"{{ownerUserId}}\",\n  \"name\": \"Charge Test Property\"\n}"
                        }
