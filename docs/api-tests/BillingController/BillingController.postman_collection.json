{
  "info": {
    "name": "RentERP \u2014 BillingController (Phase 5, pass 1 + 2)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Tariff versions, billing runs, tenant bills, adjustments. Set {{baseUrl}}=http://localhost:8080/api/v1 and the {{propertyId}}/{{runId}}/{{membershipId}}/{{tariffId}} variables from earlier responses."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "propertyId",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "membershipId",
      "value": ""
    },
    {
      "key": "tariffId",
      "value": ""
    },
    {
      "key": "billId",
      "value": ""
    }
