              "mode": "raw",
              "raw": "{\n  \"name\": \"NEA 2082 rev\",\n  \"effectiveFromBs\": \"2082-01-01\",\n  \"slabs\": [\n    {\n      \"uptoUnits\": null,\n      \"ratePerUnit\": 12\n    }\n  ],\n  \"demandCharge\": 80,\n  \"serviceCharge\": 0,\n  \"minimumCharge\": 0,\n  \"vatPercent\": 13\n}"
