  "item": [
    {
      "name": "Tariff versions",
      "item": [
        {
          "name": "Create tariff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tariffs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tariffs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"NEA 2082\",\n  \"effectiveFromBs\": \"2082-01-01\",\n  \"slabs\": [\n    {\n      \"uptoUnits\": 20,\n      \"ratePerUnit\": 8.5\n    },\n    {\n      \"uptoUnits\": null,\n      \"ratePerUnit\": 11.0\n    }\n  ],\n  \"demandCharge\": 75,\n  \"serviceCharge\": 0,\n  \"minimumCharge\": 0,\n  \"vatPercent\": 13\n}"
            }
          }
        },
        {
          "name": "Get tariff",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
