              "path": [
                "tenant-bills",
                "{{billId}}",
                "correct"
              ]
            },
            "description": "Unpaid bill -> CANCEL_REGENERATE: original cancelled, replacement issued, supersedes chain.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correctedTotalDue\": 12000,\n  \"reason\": \"missed a charge\"\n}"
            }
          }
        },
        {
          "name": "Correct bill \u2014 paid/partial (next-bill adjustment)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tenant-bills/{{billId}}/correct",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tenant-bills",
                "{{billId}}",
                "correct"
              ]
            },
            "description": "Paid/partial bill -> NEXT_BILL_ADJUSTMENT: PENDING tenant_bill_adjustments row carried to the next bill.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deltaAmount\": 300,\n  \"reason\": \"extra service\"\n}"
            }
          }
        }
