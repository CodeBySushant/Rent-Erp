    {
      "name": "Pass 2 \u2014 metered / corrections / async",
      "item": [
        {
          "name": "Generate SUB_METERED FLAT_RATE run",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/properties/{{propertyId}}/billing-runs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "properties",
                "{{propertyId}}",
                "billing-runs"
              ]
            },
            "description": "SUB_METERED + FLAT_RATE: per-tenant electricity = confirmed sub-meter units x rate.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"billingMonthBs\": \"2082-04\",\n  \"periodStartBs\": \"2082-04-01\",\n  \"periodEndBs\": \"2082-04-31\",\n  \"generatedAtBs\": \"2082-05-01\",\n  \"electricityRatePerUnit\": 15\n}"
            }
          }
        },
        {
          "name": "Generate SUB_METERED BLENDED_RATE run",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/properties/{{propertyId}}/billing-runs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "properties",
                "{{propertyId}}",
                "billing-runs"
              ]
            },
            "description": "BLENDED_RATE: main-meter units -> tariff slabs -> blended rate; nea_* stored on the run.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"billingMonthBs\": \"2082-04\",\n  \"periodStartBs\": \"2082-04-01\",\n  \"periodEndBs\": \"2082-04-31\",\n  \"generatedAtBs\": \"2082-05-01\"\n}"
            }
          }
        },
        {
          "name": "Generate CUSTOM split run",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/properties/{{propertyId}}/billing-runs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "properties",
                "{{propertyId}}",
                "billing-runs"
              ]
            },
            "description": "CUSTOM split: per-membership weights (3:1 -> 750/250).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"billingMonthBs\": \"2082-04\",\n  \"periodStartBs\": \"2082-04-01\",\n  \"periodEndBs\": \"2082-04-31\",\n  \"generatedAtBs\": \"2082-05-01\",\n  \"electricityTotalAmount\": 1000,\n  \"customWeights\": {\n    \"<membershipId-A>\": 3,\n    \"<membershipId-B>\": 1\n  }\n}"
            }
          }
        },
        {
          "name": "Generate KUKL + boring water run",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/properties/{{propertyId}}/billing-runs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "properties",
                "{{propertyId}}",
                "billing-runs"
              ]
            },
            "description": "KUKL_AND_BORING water: both amounts split segment-aware across tenants.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"billingMonthBs\": \"2082-04\",\n  \"periodStartBs\": \"2082-04-01\",\n  \"periodEndBs\": \"2082-04-31\",\n  \"generatedAtBs\": \"2082-05-01\",\n  \"waterKuklAmount\": 800,\n  \"waterBoringAmount\": 200\n}"
            }
          }
        },
        {
          "name": "Generate ASYNC run (B15)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/properties/{{propertyId}}/billing-runs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "properties",
                "{{propertyId}}",
                "billing-runs"
              ]
            },
            "description": "Force the async worker path; poll the progress endpoint until COMPLETED.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"billingMonthBs\": \"2082-04\",\n  \"periodStartBs\": \"2082-04-01\",\n  \"periodEndBs\": \"2082-04-31\",\n  \"generatedAtBs\": \"2082-05-01\",\n  \"async\": true\n}"
            }
          }
        },
        {
          "name": "Get run progress (B15 poll)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/billing-runs/{{runId}}/progress",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "billing-runs",
                "{{runId}}",
                "progress"
              ]
            },
            "description": "Async progress: RUNNING -> COMPLETED | FAILED. Poll ~2s."
          }
        },
        {
          "name": "Correct bill \u2014 unpaid (cancel+regenerate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tenant-bills/{{billId}}/correct",
